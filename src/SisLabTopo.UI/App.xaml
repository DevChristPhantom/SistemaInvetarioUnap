<Application x:Class="SisLabTopo.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SisLabTopo.UI"
             xmlns:converters="clr-namespace:SisLabTopo.UI.Converters"
             xmlns:shell="clr-namespace:SisLabTopo.UI.Shell">
    <!--
        Nota de arranque: esta app YA NO usa StartupUri (que crearía MainWindow
        automáticamente antes de que el host de DI de App.xaml.cs esté listo). El
        arranque completo (construir el IHost, inicializar la base de datos, y mostrar
        la primera ventana de Login) ocurre explícitamente en App.OnStartup().
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/Spacing.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters de uso global -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:ViewModelIsTypeConverter x:Key="ViewModelIsTypeConverter"/>
            <converters:EstadoEquipoToBrushConverter x:Key="EstadoEquipoToBrushConverter"/>
            <converters:EstadoEquipoToTextConverter x:Key="EstadoEquipoToTextConverter"/>
            <converters:EstadoPrestamoToBrushConverter x:Key="EstadoPrestamoToBrushConverter"/>
            <converters:EstadoPrestamoToTextConverter x:Key="EstadoPrestamoToTextConverter"/>
            <converters:DisponibilidadToBrushConverter x:Key="DisponibilidadToBrushConverter"/>
            <converters:DisponibilidadToTextConverter x:Key="DisponibilidadToTextConverter"/>

            <!--
                Navegación por contenido dentro del Shell: un único DataTemplate para el
                ViewModel base PlaceholderViewModel cubre las 5 subclases concretas
                (Dashboard/Equipos/Préstamos/Historial/Configuración de la Fase 4), ya
                que WPF resuelve la plantilla implícita por el tipo exacto o el tipo base
                más cercano. La Fase 5 reemplaza esto por un DataTemplate por cada
                ViewModel real; el Shell no necesita cambios.
            -->
            <DataTemplate DataType="{x:Type shell:PlaceholderViewModel}">
                <shell:PlaceholderView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
