<Application x:Class="SisLabTopo.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SisLabTopo.UI"
             xmlns:converters="clr-namespace:SisLabTopo.UI.Converters"
             xmlns:equipos="clr-namespace:SisLabTopo.UI.Equipos"
             xmlns:prestamos="clr-namespace:SisLabTopo.UI.Prestamos"
             xmlns:dashboard="clr-namespace:SisLabTopo.UI.Dashboard"
             xmlns:historial="clr-namespace:SisLabTopo.UI.Historial"
             xmlns:configuracion="clr-namespace:SisLabTopo.UI.Configuracion">
    <!--
        Nota de arranque: esta app YA NO usa StartupUri (que crearía MainWindow
        automáticamente antes de que el host de DI de App.xaml.cs esté listo). El
        arranque completo (construir el IHost, inicializar la base de datos, y mostrar
        la primera ventana de Login) ocurre explícitamente en App.OnStartup().
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/Spacing.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters de uso global -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:ViewModelIsTypeConverter x:Key="ViewModelIsTypeConverter"/>
            <converters:EstadoEquipoToBrushConverter x:Key="EstadoEquipoToBrushConverter"/>
            <converters:EstadoEquipoToTextConverter x:Key="EstadoEquipoToTextConverter"/>
            <converters:TipoEquipoToTextConverter x:Key="TipoEquipoToTextConverter"/>
            <converters:EstadoPrestamoToBrushConverter x:Key="EstadoPrestamoToBrushConverter"/>
            <converters:EstadoPrestamoToTextConverter x:Key="EstadoPrestamoToTextConverter"/>
            <converters:DisponibilidadToBrushConverter x:Key="DisponibilidadToBrushConverter"/>
            <converters:DisponibilidadToTextConverter x:Key="DisponibilidadToTextConverter"/>

            <!--
                Navegación por contenido dentro del Shell: un DataTemplate explícito por
                cada ViewModel real de los 5 destinos (Dashboard/Equipos/Préstamos/
                Historial/Configuración). Los 3 últimos (Dashboard/Historial/
                Configuración) reemplazan aquí, en la Fase 5b, al PlaceholderViewModel
                genérico que usaba la Fase 4; Equipos y Préstamos ya habían sido
                reemplazados por la Fase 5a.
            -->
            <DataTemplate DataType="{x:Type equipos:EquiposViewModel}">
                <equipos:EquiposView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type prestamos:PrestamosViewModel}">
                <prestamos:PrestamosView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
                <dashboard:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type historial:HistorialViewModel}">
                <historial:HistorialView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type configuracion:ConfiguracionViewModel}">
                <configuracion:ConfiguracionView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
