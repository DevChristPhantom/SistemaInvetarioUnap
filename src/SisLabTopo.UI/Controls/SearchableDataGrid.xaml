<UserControl x:Class="SisLabTopo.UI.Controls.SearchableDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="600" d:DesignHeight="360">
    <!--
        TextBox de búsqueda (icono de lupa + botón de limpiar) sobre un DataGrid
        estilizado, con filtrado case-insensitive vía ICollectionView.Filter. Puerto
        funcional de ui.components.SearchableTable<T> (Java). Los iconos de lupa/limpiar
        se dibujan con la fuente "Segoe MDL2 Assets" (incluida en Windows) en vez de
        emojis o PNGs, igual de "sin emojis, vectorial" que el criterio ya usado en
        LoginPanel.java, sin añadir ningún paquete de iconos externo.

        Fase B (rediseño de tablas): paginación en memoria añadida sobre la lista YA
        filtrada/cargada (ver PageSize/CurrentPage/TotalPages en el code-behind): sin
        tocar SisLabTopo.Services ni los ViewModels de cada pantalla, para que Equipos/
        Préstamos/Historial/Disponibilidad Rápida (Dashboard) la reciban gratis al
        compartir este mismo control. Se usan "‹"/"›" (puntuación Unicode estándar, no
        una fuente de iconos) para los botones Anterior/Siguiente: cero riesgo de
        "codepoint" de glifo no verificado, igual de accesible que un glifo real.
    -->
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Margin="0,0,0,10"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderLightBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource TextBoxCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{DynamicResource TextLightBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,4,0"/>

                <TextBox x:Name="PART_SearchBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="4,8"
                         VerticalContentAlignment="Center"
                         Tag="Buscar..."
                         Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="2"
                        Style="{StaticResource LinkButtonStyle}"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Padding="8,0,10,0"
                        ToolTip="Limpiar búsqueda"
                        Visibility="{Binding HasSearchText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="ClearButton_Click"/>
            </Grid>
        </Border>

        <!--
            Barra de paginación: solo visible cuando hay más resultados filtrados que
            PageSize (ShowPagination, calculado en el code-behind). Docked Bottom ANTES
            que el DataGrid para que este último siga siendo el "último hijo" que llena
            el espacio restante (DockPanel.LastChildFill).
        -->
        <Border DockPanel.Dock="Bottom"
                Margin="0,10,0,0"
                Padding="4,0"
                Visibility="{Binding ShowPagination, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding PageInfoText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource SmallStyle}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="‹ Anterior"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6"
                            FontSize="12"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanGoPrevious, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Click="PreviousPageButton_Click"/>
                    <Button Content="Siguiente ›"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,6"
                            FontSize="12"
                            IsEnabled="{Binding CanGoNext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Click="NextPageButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="PART_DataGrid"
                  DockPanel.Dock="Bottom"
                  CanUserSortColumns="False"
                  SelectionChanged="InnerDataGrid_SelectionChanged"/>
    </DockPanel>
</UserControl>
