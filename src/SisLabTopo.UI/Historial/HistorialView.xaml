<UserControl x:Class="SisLabTopo.UI.Historial.HistorialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SisLabTopo.UI.Controls"
             xmlns:historial="clr-namespace:SisLabTopo.UI.Historial"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=historial:HistorialViewModel}"
             d:DesignWidth="1100" d:DesignHeight="600">
    <!--
        Puerto funcional de HistorialPanel.java: barra de filtros (Card blanca
        redondeada) arriba + tabla completa de préstamos abajo. Desde/Hasta usan
        DatePicker real de WPF (mejora explícita sobre los JTextField de texto libre sin
        validación que tenía Java).
    -->
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de filtros -->
        <controls:RoundedCard Grid.Row="0" Margin="0,0,0,16" Padding="18,12">
            <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                <TextBlock Text="Desde:" Style="{StaticResource BodyStyle}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FechaDesde}" Width="130" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <TextBlock Text="Hasta:" Style="{StaticResource BodyStyle}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FechaHasta}" Width="130" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <TextBlock Text="Estado:" Style="{StaticResource BodyStyle}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding OpcionesEstado}" DisplayMemberPath="Etiqueta"
                          SelectedItem="{Binding EstadoSeleccionado}" Width="130" Margin="0,0,16,0"/>

                <TextBlock Text="Semestre:" Style="{StaticResource BodyStyle}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding OpcionesSemestre}"
                          SelectedItem="{Binding SemestreSeleccionado}" Width="110" Margin="0,0,16,0"/>

                <Button Command="{Binding FiltrarCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <!-- Lupa (Segoe MDL2 Assets, codepoint E721 "Zoom"): mismo glifo que usa el propio SearchableDataGrid para su caja de búsqueda. -->
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Filtrar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportarExcelCommand}" Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Margin="0,0,8,0" Fill="White">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/archivo.png" Stretch="Uniform"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="Exportar Excel" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:RoundedCard>

        <!-- Tabla -->
        <controls:SearchableDataGrid x:Name="TablaHistorial"
                                      Grid.Row="1"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                      ItemsSource="{Binding Prestamos}">
            <controls:SearchableDataGrid.Columns>
                <DataGridTextColumn Header="ID Corto" Binding="{Binding IdCorto}" Width="90"/>
                <DataGridTextColumn Header="Estudiante" Binding="{Binding Prestamo.NombreEstudiante}" Width="*"/>
                <DataGridTextColumn Header="Docente" Binding="{Binding Prestamo.Docente}" Width="150"/>
                <DataGridTextColumn Header="Curso" Binding="{Binding Prestamo.Curso}" Width="150"/>
                <DataGridTextColumn Header="Semestre" Binding="{Binding Prestamo.Semestre}" Width="90"/>
                <DataGridTextColumn Header="Fecha Préstamo" Binding="{Binding Prestamo.FechaPrestamo, StringFormat='dd/MM/yyyy'}" Width="110"/>
                <DataGridTextColumn Header="Fecha Devolución" Width="120">
                    <DataGridTextColumn.Binding>
                        <Binding Path="Prestamo.FechaDevolucion" StringFormat="dd/MM/yyyy" TargetNullValue="Activo"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Estado" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:StatusBadge BadgeText="{Binding Prestamo.Estado, Converter={StaticResource EstadoPrestamoToTextConverter}}"
                                                   BadgeBrush="{Binding Prestamo.Estado, Converter={StaticResource EstadoPrestamoToBrushConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Equipos (Cant.)" Binding="{Binding CantidadEquipos}" Width="110"/>
            </controls:SearchableDataGrid.Columns>
        </controls:SearchableDataGrid>
    </Grid>
</UserControl>
