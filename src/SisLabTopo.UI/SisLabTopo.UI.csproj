<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SisLabTopo.Domain\SisLabTopo.Domain.csproj" />
    <ProjectReference Include="..\SisLabTopo.Data\SisLabTopo.Data.csproj" />
    <ProjectReference Include="..\SisLabTopo.Services\SisLabTopo.Services.csproj" />
    <ProjectReference Include="..\SisLabTopo.Reports\SisLabTopo.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="PDFtoImage" Version="5.1.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Logo_UNAP.png" />
    <Resource Include="Assets\Logo_Minas.png" />

    <!--
      Ícono de aplicación (barra de tareas, Alt+Tab, .exe, acceso directo del
      instalador): recorte simplificado del escudo institucional (Assets\Logo_UNAP.png,
      ver generación en el historial de esta fase): se retira el penacho de plumas
      lateral porque no se distingue en tamaños de 16/32px, dejando solo el cuerpo del
      escudo (franja roja + trigo/llama/pez + cinta "PUNO"). ApplicationIcon (arriba)
      lo embebe en el .exe; el Resource de aquí abajo permite además referenciarlo por
      pack URI desde Window.Icon en LoginView/ShellView.
    -->
    <Resource Include="Assets\app_icon.ico" />

    <!--
      Rediseño visual (Fase de diseño UI): iconos heredados 1:1 de la app Java
      (ui/MainFrame.java líneas 299-305, ver mapeo en Shell/ShellView.xaml), copiados
      tal cual sin editar. Se usan como OpacityMask sobre un Rectangle en el sidebar
      para poder "teñirlos" de blanco/gris-azulado según el estado activo/inactivo
      directamente desde XAML/tema, igual que hacía SwingUtils.cargarIconoTintado en
      Java pero sin fabricar un asset nuevo.
    -->
    <Resource Include="Assets\Icons\nivel-laser.png" />
    <Resource Include="Assets\Icons\pagar.png" />
    <Resource Include="Assets\Icons\archivo.png" />
    <Resource Include="Assets\Icons\config.png" />

    <!--
      Fase B (tablas/botones): mismo criterio: icono heredado 1:1 de Java
      (sislab-topo\Iconos\boton-editar.png / src\main\resources\images\boton-editar.png),
      copiado tal cual y usado como OpacityMask (blanco) sobre botones de "Editar".
    -->
    <Resource Include="Assets\Icons\boton-editar.png" />

    <!--
      Fase de estilización de íconos: set de Google Material Symbols (24dp,
      relleno #1F1F1F, fondo transparente) provisto por el usuario en
      scratch\sislab-topo-net\Iconos junto con "hogar.png" (heredado de Java,
      sin uso hasta ahora) y el ícono de cierre de sesión (recortado del set de
      Java, "esquema-del-boton..." renombrado aquí a logout.png). Mismo
      criterio de teñido por Rectangle+OpacityMask que el resto: el color real
      (blanco sobre los botones de acción, para que resalten sobre el fondo de
      color sólido) lo pone el XAML consumidor, no el PNG.
        hogar.png                    -> Dashboard (sidebar, reemplaza a tablero.png:
                                         un engranaje ahí se confundía con el
                                         engranaje de Configuración)
        precision_manufacturing.png  -> Registrar Nuevo Equipo
        front_loader.png             -> Importar (Excel): "cargar" datos
        print_add.png                -> Guardar e Imprimir
        print_connect.png            -> Imprimir
        drag_click.png               -> Ver Detalle
        logout.png                   -> ítem "Cerrar sesión" del menú de usuario
    -->
    <Resource Include="Assets\Icons\hogar.png" />
    <Resource Include="Assets\Icons\precision_manufacturing.png" />
    <Resource Include="Assets\Icons\front_loader.png" />
    <Resource Include="Assets\Icons\print_add.png" />
    <Resource Include="Assets\Icons\print_connect.png" />
    <Resource Include="Assets\Icons\drag_click.png" />
    <Resource Include="Assets\Icons\logout.png" />

    <!--
      Fase de estilización de íconos (parte 2): avatar del login (antes un círculo de
      color liso) y badges del dashboard (antes 2 letras de texto EQ/OK/PR/DV, ver
      StatCard.IconSource) piden íconos que no existen como PNG en Iconos/. En vez de
      adivinar codepoints de Segoe MDL2 Assets sin poder verlos (criterio ya establecido
      en el proyecto), se rasterizó el glifo real de la fuente instalada en Windows a
      PNG (mismo estilo 1F1F1F/transparente que el resto del set) y se revisó
      visualmente antes de usarlo:
        user.png       (glifo "Contact", E77B)    -> avatar circular del login
        checkmark.png  (glifo "CheckMark", E73E)  -> StatCard "Equipos Disponibles"
        undo.png       (glifo "Undo", E7A7)       -> StatCard "Devoluciones Hoy" y
                                                      los botones "Registrar Devolución"
                                                      (reemplaza al glifo de fuente que
                                                      usaban directo, por consistencia)
    -->
    <Resource Include="Assets\Icons\user.png" />
    <Resource Include="Assets\Icons\checkmark.png" />
    <Resource Include="Assets\Icons\undo.png" />
  </ItemGroup>

</Project>
