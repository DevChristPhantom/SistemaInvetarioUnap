<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SisLabTopo.Domain\SisLabTopo.Domain.csproj" />
    <ProjectReference Include="..\SisLabTopo.Data\SisLabTopo.Data.csproj" />
    <ProjectReference Include="..\SisLabTopo.Services\SisLabTopo.Services.csproj" />
    <ProjectReference Include="..\SisLabTopo.Reports\SisLabTopo.Reports.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="PDFtoImage" Version="5.1.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Logo_UNAP.png" />
    <Resource Include="Assets\Logo_Minas.png" />

    <!--
      Rediseño visual (Fase de diseño UI): iconos heredados 1:1 de la app Java
      (ui/MainFrame.java líneas 299-305, ver mapeo en Shell/ShellView.xaml), copiados
      tal cual sin editar. Se usan como OpacityMask sobre un Rectangle en el sidebar
      para poder "teñirlos" de blanco/gris-azulado según el estado activo/inactivo
      directamente desde XAML/tema, igual que hacía SwingUtils.cargarIconoTintado en
      Java pero sin fabricar un asset nuevo.
    -->
    <Resource Include="Assets\Icons\tablero.png" />
    <Resource Include="Assets\Icons\nivel-laser.png" />
    <Resource Include="Assets\Icons\pagar.png" />
    <Resource Include="Assets\Icons\archivo.png" />
    <Resource Include="Assets\Icons\config.png" />

    <!--
      Fase B (tablas/botones): mismo criterio: icono heredado 1:1 de Java
      (sislab-topo\Iconos\boton-editar.png / src\main\resources\images\boton-editar.png),
      copiado tal cual y usado como OpacityMask (blanco) sobre botones de "Editar".
    -->
    <Resource Include="Assets\Icons\boton-editar.png" />
  </ItemGroup>

</Project>
