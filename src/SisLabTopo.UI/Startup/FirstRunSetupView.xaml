<Window x:Class="SisLabTopo.UI.Startup.FirstRunSetupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:startup="clr-namespace:SisLabTopo.UI.Startup"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=startup:FirstRunSetupViewModel}"
        Title="SisLab-Topo — Configuración Inicial"
        Icon="pack://application:,,,/SisLabTopo.UI;component/Assets/app_icon.ico"
        Width="1000" Height="660"
        MinWidth="780" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <!--
        Asistente de primer arranque (Fase 6): sustituye la contraseña por defecto
        "admin123" (hardcodeada y anunciada en texto plano por el instalador Java) por un
        flujo obligatorio de creación de contraseña + generación de código de
        recuperación. Misma identidad visual que LoginView (columna institucional a la
        derecha, formulario a la izquierda), con dos pasos alternados por Visibility.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.46*"/>
            <ColumnDefinition Width="0.54*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== IZQUIERDA: asistente ===================== -->
        <Grid Grid.Column="0" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Paso 1: crear contraseña ===== -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Stretch"
                        Visibility="{Binding MostrandoCodigo, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                <TextBlock Text="CONFIGURACIÓN INICIAL" Style="{StaticResource SmallStyle}" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center">
                    <Rectangle Width="38" Height="38" Fill="White">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/user.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Border>

                <TextBlock Text="Bienvenido a SisLab-Topo" FontFamily="{StaticResource AppFontFamily}"
                           FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,4"/>

                <TextBlock Text="Este es el primer arranque del sistema. Cree la contraseña de la cuenta de administrador para continuar."
                           Style="{StaticResource SmallStyle}" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Nueva Contraseña (mín. 6 caracteres)" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordNueva" Height="42" FontSize="14" Margin="0,0,0,2"
                             PasswordChanged="PasswordNueva_PasswordChanged"/>
                <TextBlock Text="{Binding MensajeErrorNueva}" Style="{StaticResource SmallStyle}" FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,12" TextWrapping="Wrap"
                           Visibility="{Binding MensajeErrorNueva, Converter={StaticResource StringToVisibilityConverter}}"/>

                <TextBlock Text="Confirmar Contraseña" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordConfirmar" Height="42" FontSize="14" Margin="0,0,0,2"
                             PasswordChanged="PasswordConfirmar_PasswordChanged"/>
                <TextBlock Text="{Binding MensajeErrorConfirmar}" Style="{StaticResource SmallStyle}" FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,12" TextWrapping="Wrap"
                           Visibility="{Binding MensajeErrorConfirmar, Converter={StaticResource StringToVisibilityConverter}}"/>

                <TextBlock Text="{Binding MensajeError}" Style="{StaticResource SmallStyle}" FontWeight="Bold"
                           Foreground="{DynamicResource DangerBrush}" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,4,0,0"
                           Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>

                <Button Content="CREAR CUENTA DE ADMINISTRADOR" Command="{Binding CrearCuentaCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Height="42" Margin="0,16,0,0"/>
            </StackPanel>

            <!-- ===== Paso 2: mostrar código de recuperación (una sola vez) ===== -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Stretch"
                        Visibility="{Binding MostrandoCodigo, Converter={StaticResource BoolToVisibilityConverter}}">

                <TextBlock Text="CUENTA CREADA CON ÉXITO" Style="{StaticResource SmallStyle}" FontWeight="Bold"
                           Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                <TextBlock Text="Su código de recuperación" FontFamily="{StaticResource AppFontFamily}"
                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,4"/>

                <TextBlock Text="Guarde este código en un lugar seguro; no podrá volver a verlo. Lo necesitará para restablecer la contraseña si la olvida."
                           Style="{StaticResource SmallStyle}" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                    <TextBlock Text="{Binding CodigoRecuperacion}" Style="{StaticResource MonoStyle}"
                               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <Button Content="COPIAR AL PORTAPAPELES" Command="{Binding CopiarCodigoCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Height="38" Margin="0,0,0,18"/>

                <CheckBox Content="Ya guardé el código de recuperación en un lugar seguro."
                          IsChecked="{Binding ConfirmoQueGuardeElCodigo}"
                          FontFamily="{StaticResource AppFontFamily}" FontSize="12"
                          Foreground="{DynamicResource TextDarkBrush}"
                          HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <Button Content="CONTINUAR AL INICIO DE SESIÓN" Command="{Binding ContinuarCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Height="42"/>
            </StackPanel>
        </Grid>

        <!-- ===================== DERECHA: institucional ===================== -->
        <Border Grid.Column="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0A1D37" Offset="0"/>
                    <GradientStop Color="#0E4C92" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Margin="0,0,40,0" Width="150">
                        <Image Source="pack://application:,,,/SisLabTopo.UI;component/Assets/Logo_UNAP.png" Width="110" Height="110"/>
                        <TextBlock Text="UNIVERSIDAD NACIONAL DEL ALTIPLANO"
                                   FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold"
                                   FontSize="12" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="PUNO" FontFamily="{StaticResource AppFontFamily}" FontSize="11"
                                   Foreground="#b0c4de" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Width="150">
                        <Image Source="pack://application:,,,/SisLabTopo.UI;component/Assets/Logo_Minas.png" Width="110" Height="110"/>
                        <TextBlock Text="ESCUELA PROFESIONAL DE INGENIERÍA DE MINAS"
                                   FontFamily="{StaticResource AppFontFamily}" FontWeight="Bold"
                                   FontSize="12" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="UNA - PUNO" FontFamily="{StaticResource AppFontFamily}" FontSize="11"
                                   Foreground="#b0c4de" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Background="#1EFFFFFF" CornerRadius="16" Padding="25,8" Margin="0,0,0,10">
                    <TextBlock Text="Sistema Administrativo   |   Configuración Inicial de Seguridad"
                               FontFamily="{StaticResource AppFontFamily}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
