<UserControl x:Class="SisLabTopo.UI.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SisLabTopo.UI.Controls"
             xmlns:dashboard="clr-namespace:SisLabTopo.UI.Dashboard"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=dashboard:DashboardViewModel}"
             d:DesignWidth="1300" d:DesignHeight="760">
    <!--
        Puerto funcional de DashboardPanel.java: 4 StatCard arriba, rejilla 60/40 debajo
        (izquierda: 2 gráficos + 2 mini-tablas; derecha: Acciones Rápidas +
        Disponibilidad Rápida). Todo deshabilitado (IsEnabled) mientras IsBusy, igual que
        el resto de pantallas de la Fase 5.
    -->
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Fila 1: tarjetas de estadística ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:StatCard Grid.Column="0" Margin="0,0,8,0"
                                Title="Total Equipos" Value="{Binding TotalEquiposTexto}" Description="Registrados"
                                IconSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/nivel-laser.png" IconBrush="{DynamicResource PrimaryBrush}"
                                TrendText="{Binding TotalEquiposTrendTexto}" TrendDirection="{Binding TotalEquiposTrendDireccion}"
                                SparklineValues="{Binding TotalEquiposSparkline}"/>
            <controls:StatCard Grid.Column="1" Margin="8,0,8,0"
                                Title="Equipos Disponibles" Value="{Binding EquiposDisponiblesTexto}" Description="Listos para préstamo"
                                IconSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/checkmark.png" IconBrush="{DynamicResource SuccessBrush}"
                                TrendText="{Binding EquiposDisponiblesTrendTexto}" TrendDirection="{Binding EquiposDisponiblesTrendDireccion}"
                                SparklineValues="{Binding EquiposDisponiblesSparkline}"/>
            <controls:StatCard Grid.Column="2" Margin="8,0,8,0"
                                Title="Préstamos Activos" Value="{Binding PrestamosActivosTexto}" Description="Equipos en préstamo"
                                IconSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/pagar.png" IconBrush="{DynamicResource AccentBrush}"
                                TrendText="{Binding PrestamosActivosTrendTexto}" TrendDirection="{Binding PrestamosActivosTrendDireccion}"
                                SparklineValues="{Binding PrestamosActivosSparkline}"/>
            <controls:StatCard Grid.Column="3" Margin="8,0,0,0"
                                Title="Devoluciones Hoy" Value="{Binding DevolucionesHoyTexto}" Description="Esperando devolución"
                                IconSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/undo.png"
                                TrendText="{Binding DevolucionesHoyTrendTexto}" TrendDirection="{Binding DevolucionesHoyTrendDireccion}"
                                SparklineValues="{Binding DevolucionesHoySparkline}">
                <controls:StatCard.IconBrush>
                    <SolidColorBrush Color="#6f42c1"/>
                </controls:StatCard.IconBrush>
            </controls:StatCard>
        </Grid>

        <!-- ===================== Fila 2: rejilla 60/40 ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.4*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Columna izquierda: gráficos + tablas ===== -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Gráficos -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Donut: distribución de equipos por estado -->
                    <controls:RoundedCard Grid.Column="0" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Distribución de Equipos por Estado" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,8"/>
                            <Grid Grid.Row="1">
                                <!--
                                    LegendTextPaint (gris neutro, contraste aceptable en claro Y oscuro) se
                                    asigna en DashboardView.xaml.cs, no aquí: SKColor no tiene TypeConverter
                                    de XAML para "#RRGGBB" (a diferencia de System.Windows.Media.Color).
                                -->
                                <lvc:PieChart x:Name="GraficoEstadoEquipos"
                                              Series="{Binding SeriesEstadoEquipos}"
                                              LegendPosition="Bottom"
                                              Background="{DynamicResource CardBrush}"
                                              Visibility="{Binding HayDatosGraficoEstado, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding SinDatosGraficoEstado, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Sin datos disponibles" Style="{StaticResource BodyStyle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Los datos aparecerán aquí cuando existan registros."
                                               Style="{StaticResource SmallStyle}" HorizontalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </controls:RoundedCard>

                    <!-- Barras: préstamos registrados por mes -->
                    <controls:RoundedCard Grid.Column="1" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Préstamos Registrados por Mes" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Grid.Row="1"
                                                 Series="{Binding SeriesPrestamosPorMes}"
                                                 XAxes="{Binding XAxesPrestamosPorMes}"
                                                 YAxes="{Binding YAxesPrestamosPorMes}"
                                                 Background="{DynamicResource CardBrush}"/>
                        </Grid>
                    </controls:RoundedCard>
                </Grid>

                <!-- Mini-tablas -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--
                        Últimos préstamos activos: timeline visual (línea vertical +
                        puntos + fecha/estudiante/equipo) en vez de la mini-tabla plana
                        de la Fase 5: "fila 3: timeline" pedida explícitamente para
                        esta fase. El punto de cada ítem se colorea con el mismo
                        converter/paleta que cualquier StatusBadge de préstamo (azul
                        Activo / rojo Vencido), para consistencia visual con el resto de
                        la app. UltimosPrestamosActivos (la colección plana original)
                        se mantiene intacta en el ViewModel: este timeline consume la
                        colección nueva TimelinePrestamosActivos, que envuelve los mismos
                        5 préstamos con el resumen de equipo(s) prestado(s).
                    -->
                    <controls:RoundedCard Grid.Column="0" Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Últimos Préstamos Activos" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,8"/>
                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding HayPrestamosActivosRecientes, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding TimelinePrestamosActivos}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Línea vertical continua + punto de estado (Activo=azul/Vencido=rojo, igual criterio que StatusBadge) -->
                                                    <Grid Grid.Column="0">
                                                        <Rectangle Width="2"
                                                                   Fill="{DynamicResource BorderLightBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Stretch"
                                                                   Margin="0,4,0,-14"/>
                                                        <Ellipse Width="11" Height="11"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Top"
                                                                 Stroke="{DynamicResource CardBrush}" StrokeThickness="2"
                                                                 Fill="{Binding Prestamo.Estado, Converter={StaticResource EstadoPrestamoToBrushConverter}}"/>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Prestamo.FechaPrestamo, StringFormat='dd/MM/yyyy HH:mm'}"
                                                                   Style="{StaticResource SmallStyle}"/>
                                                        <TextBlock Text="{Binding Prestamo.NombreEstudiante}"
                                                                   Style="{StaticResource BodyStyle}" FontWeight="Bold"
                                                                   Margin="0,1,0,0"/>
                                                        <TextBlock Style="{StaticResource SmallStyle}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Prestamo.Curso, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding EquipoResumen, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding SinPrestamosActivosRecientes, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="No hay préstamos activos." Style="{StaticResource BodyStyle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Los préstamos activos aparecerán aquí."
                                               Style="{StaticResource SmallStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </controls:RoundedCard>

                    <!-- Equipos más prestados -->
                    <controls:RoundedCard Grid.Column="1" Margin="8,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Equipos Más Prestados (Top 5)" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,8"/>
                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding EquiposMasPrestados}"
                                          Visibility="{Binding HayEquiposMasPrestados, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Código Equipo" Binding="{Binding Codigo}" Width="120"/>
                                        <DataGridTextColumn Header="Denominación" Binding="{Binding Denominacion}" Width="*"/>
                                        <DataGridTextColumn Header="Cant. Préstamos" Binding="{Binding Cantidad}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding SinEquiposMasPrestados, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="No hay datos para mostrar." Style="{StaticResource BodyStyle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Los equipos más prestados aparecerán aquí."
                                               Style="{StaticResource SmallStyle}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </controls:RoundedCard>
                </Grid>
            </Grid>

            <!-- ===== Columna derecha: Acciones Rápidas + Disponibilidad Rápida ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.4*"/>
                    <RowDefinition Height="0.6*"/>
                </Grid.RowDefinitions>

                <controls:RoundedCard Grid.Row="0" Margin="0,0,0,16">
                    <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Acciones Rápidas" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,10"/>
                        <!--
                            Fase de estilización de íconos: cada acción rápida gana un
                            ícono a la izquierda del texto (antes solo texto sobre la
                            barra de color, ver historial de esta fase). Mismo criterio
                            de Rectangle+OpacityMask que EquiposView/ShellView: Fill
                            blanco fijo (no DynamicResource) porque el fondo de estos
                            botones ya es un color sólido de marca (verde/azul/navy) que
                            no cambia entre tema claro/oscuro, así que blanco siempre da
                            el contraste más alto posible.
                        -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Top">
                            <Button Command="{Binding NuevoPrestamoCommand}" AutomationProperties.Name="Nuevo Préstamo de Equipos"
                                    Style="{StaticResource SuccessButtonStyle}" Height="38" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="16" Margin="0,0,8,0" Fill="White">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/pagar.png" Stretch="Uniform"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="Nuevo Préstamo de Equipos" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RegistrarDevolucionRapidaCommand}" AutomationProperties.Name="Registrar Devolución Rápida"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="38" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="16" Margin="0,0,8,0" Fill="White">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/undo.png" Stretch="Uniform"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="Registrar Devolución Rápida" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RegistrarNuevoEquipoCommand}" AutomationProperties.Name="Registrar Nuevo Equipo"
                                    Style="{StaticResource PrimaryButtonStyle}" Height="38" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="16" Margin="0,0,8,0" Fill="White">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/precision_manufacturing.png" Stretch="Uniform"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="Registrar Nuevo Equipo" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportarEquiposExcelCommand}" AutomationProperties.Name="Importar Equipos (Excel)"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="38" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="16" Margin="0,0,8,0" Fill="White">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/front_loader.png" Stretch="Uniform"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="Importar Equipos (Excel)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportarInventarioExcelCommand}" AutomationProperties.Name="Exportar Inventario (Excel)"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="38">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="16" Margin="0,0,8,0" Fill="White">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/archivo.png" Stretch="Uniform"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="Exportar Inventario (Excel)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </controls:RoundedCard>

                <controls:RoundedCard Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Disponibilidad Rápida" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,8"/>
                        <controls:SearchableDataGrid Grid.Row="1" ItemsSource="{Binding EquiposDisponiblesRapida}">
                            <controls:SearchableDataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="90"/>
                                <DataGridTextColumn Header="Denominación" Binding="{Binding Denominacion}" Width="*"/>
                                <DataGridTextColumn Header="Categoría" Binding="{Binding Tipo, Converter={StaticResource TipoEquipoToTextConverter}}" Width="100"/>
                                <DataGridTemplateColumn Header="Estado" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:StatusBadge BadgeText="{Binding Estado, Converter={StaticResource EstadoEquipoToTextConverter}}"
                                                                   BadgeBrush="{Binding Estado, Converter={StaticResource EstadoEquipoToBrushConverter}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </controls:SearchableDataGrid.Columns>
                        </controls:SearchableDataGrid>
                    </Grid>
                </controls:RoundedCard>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
