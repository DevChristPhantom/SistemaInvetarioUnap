<Window x:Class="SisLabTopo.UI.Prestamos.EquipoSearchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:SisLabTopo.UI.Controls"
        xmlns:prestamos="clr-namespace:SisLabTopo.UI.Prestamos"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=prestamos:EquipoSearchViewModel}"
        Title="Buscar Equipo Disponible"
        Width="600" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:SearchableDataGrid x:Name="TablaBusqueda"
                                      Grid.Row="0"
                                      ItemsSource="{Binding EquiposDisponibles}"
                                      SelectedItem="{Binding EquipoResaltado, Mode=TwoWay}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
            <controls:SearchableDataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100"/>
                <DataGridTextColumn Header="Denominación" Binding="{Binding Denominacion}" Width="*"/>
                <DataGridTextColumn Header="Marca" Binding="{Binding Marca}" Width="110"/>
                <DataGridTextColumn Header="Modelo" Binding="{Binding Modelo}" Width="110"/>
                <DataGridTemplateColumn Header="Estado" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:StatusBadge BadgeText="{Binding Estado, Converter={StaticResource EstadoEquipoToTextConverter}}"
                                                   BadgeBrush="{Binding Estado, Converter={StaticResource EstadoEquipoToBrushConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </controls:SearchableDataGrid.Columns>
        </controls:SearchableDataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Seleccionar" Command="{Binding SeleccionarCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
        </StackPanel>
    </Grid>
</Window>
