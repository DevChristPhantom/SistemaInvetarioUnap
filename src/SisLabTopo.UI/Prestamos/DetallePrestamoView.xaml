<Window x:Class="SisLabTopo.UI.Prestamos.DetallePrestamoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:prestamos="clr-namespace:SisLabTopo.UI.Prestamos"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=prestamos:DetallePrestamoViewModel}"
        Title="Detalle de Préstamo"
        Width="480" SizeToContent="Height" MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Prestamo.Id, StringFormat='Préstamo ID: {0}'}" Style="{StaticResource SmallStyle}"/>
        <TextBlock Style="{StaticResource BodyStyle}" Margin="0,8,0,0">
            <Run Text="Estudiante: " FontWeight="Bold"/>
            <Run Text="{Binding Prestamo.NombreEstudiante, Mode=OneWay}"/>
            <Run Text=" (Cód: "/>
            <Run Text="{Binding Prestamo.CodigoEstudiante, Mode=OneWay}"/>
            <Run Text=")"/>
        </TextBlock>
        <TextBlock Style="{StaticResource BodyStyle}" Margin="0,4,0,0">
            <Run Text="Docente: " FontWeight="Bold"/>
            <Run Text="{Binding Prestamo.Docente, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource BodyStyle}" Margin="0,4,0,0">
            <Run Text="Curso: " FontWeight="Bold"/>
            <Run Text="{Binding Prestamo.Curso, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Style="{StaticResource BodyStyle}" Margin="0,4,0,12">
            <Run Text="Fecha de préstamo: " FontWeight="Bold"/>
            <Run Text="{Binding Prestamo.FechaPrestamo, Mode=OneWay, StringFormat='dd/MM/yyyy HH:mm'}"/>
        </TextBlock>

        <TextBlock Text="Equipos prestados:" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,0,0,6"/>
        <ItemsControl ItemsSource="{Binding Equipos}" MaxHeight="260">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                        <TextBlock Style="{StaticResource BodyStyle}">
                            <Run Text="{Binding Numero, Mode=OneWay}"/>
                            <Run Text=". ["/>
                            <Run Text="{Binding Codigo, Mode=OneWay}"/>
                            <Run Text="] "/>
                            <Run Text="{Binding Denominacion, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="Cerrar" Command="{Binding CerrarCommand}" Style="{StaticResource SecondaryButtonStyle}"
                Width="100" HorizontalAlignment="Right" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
