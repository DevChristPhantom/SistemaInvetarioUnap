<Window x:Class="SisLabTopo.UI.Prestamos.DevolucionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:prestamos="clr-namespace:SisLabTopo.UI.Prestamos"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=prestamos:DevolucionViewModel}"
        Title="Registrar Devolución de Equipos"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="20" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
        <TextBlock Text="¿Confirmar la devolución de los equipos?" Style="{StaticResource BodyStyle}" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="Ingrese el estado físico de recepción o novedades:" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" Margin="0,4,0,10"/>

        <!-- Border envolvente: ver comentario en LoginView.xaml / AppTextBoxStyle (Themes/Controls.xaml) sobre por qué el redondeado no vive en el ControlTemplate del TextBox. -->
        <Border CornerRadius="{StaticResource TextBoxCornerRadius}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}">
            <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0" Background="Transparent"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto"/>
        </Border>

        <TextBlock Text="{Binding MensajeError}"
                   Style="{StaticResource SmallStyle}"
                   FontWeight="Bold"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,10,0"/>
            <Button Command="{Binding RegistrarCommand}" AutomationProperties.Name="Registrar Devolución" Style="{StaticResource SuccessButtonStyle}" Width="180">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="16" Height="16" Margin="0,0,8,0" Fill="White">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/undo.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="Registrar Devolución" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
