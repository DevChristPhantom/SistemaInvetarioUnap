<Window x:Class="SisLabTopo.UI.Prestamos.NuevoPrestamoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:prestamos="clr-namespace:SisLabTopo.UI.Prestamos"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=prestamos:NuevoPrestamoViewModel}"
        Title="Nuevo Préstamo de Equipos"
        Width="760" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="20" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Datos del Solicitante ===================== -->
        <GroupBox Grid.Row="0" Header="Datos del Solicitante" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Docente:" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,5,8,5" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,5,15,5">
                    <Border CornerRadius="{StaticResource TextBoxCornerRadius}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}">
                        <TextBox x:Name="DocenteBox" BorderThickness="0" Background="Transparent" Text="{Binding Docente, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding (Validation.Errors), ElementName=DocenteBox}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ErrorContent}" Style="{StaticResource SmallStyle}" Foreground="{DynamicResource DangerBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Fecha préstamo:" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,5,8,5" VerticalAlignment="Center"/>
                <Border Grid.Row="0" Grid.Column="3" CornerRadius="{StaticResource TextBoxCornerRadius}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}" Margin="0,5,0,5">
                    <TextBox Text="{Binding FechaPrestamo, StringFormat='dd/MM/yyyy', Mode=OneTime}" IsEnabled="False" BorderThickness="0" Background="Transparent"/>
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Curso:" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,5,8,5" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5,15,5">
                    <Border CornerRadius="{StaticResource TextBoxCornerRadius}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}">
                        <TextBox x:Name="CursoBox" BorderThickness="0" Background="Transparent" Text="{Binding Curso, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding (Validation.Errors), ElementName=CursoBox}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ErrorContent}" Style="{StaticResource SmallStyle}" Foreground="{DynamicResource DangerBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Semestre:" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,5,8,5" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding SemestresDisponibles}" SelectedItem="{Binding SemestreSeleccionado}" Margin="0,5,0,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Estudiante:" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,5,8,5" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,5,15,5">
                    <Border CornerRadius="{StaticResource TextBoxCornerRadius}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}">
                        <TextBox x:Name="EstudianteBox" BorderThickness="0" Background="Transparent" Text="{Binding Estudiante, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding (Validation.Errors), ElementName=EstudianteBox}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ErrorContent}" Style="{StaticResource SmallStyle}" Foreground="{DynamicResource DangerBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="Cód. Estudiante:" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,5,8,5" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="3" Margin="0,5,0,5">
                    <Border CornerRadius="{StaticResource TextBoxCornerRadius}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}">
                        <TextBox x:Name="CodigoEstudianteBox" BorderThickness="0" Background="Transparent" Text="{Binding CodigoEstudiante, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding (Validation.Errors), ElementName=CodigoEstudianteBox}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ErrorContent}" Style="{StaticResource SmallStyle}" Foreground="{DynamicResource DangerBrush}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ===================== Equipos a Prestar (fijo: 6 ítems) ===================== -->
        <GroupBox Grid.Row="1" Header="Equipos a Prestar (Máx. 6 ítems)" Padding="10" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" Style="{StaticResource BodyStyle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Denominación del Equipo" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="Código" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="Estado" Style="{StaticResource BodyStyle}" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="Acciones" Style="{StaticResource BodyStyle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>

                <!--
                    ScrollViewer añadido tras QA manual real: sin él, las 6 filas de
                    "Filas" (fijas, ver comentario de NuevoPrestamoViewModel.Filas) no
                    caben todas dentro de la ventana de altura fija (700px,
                    ResizeMode="NoResize"): se comprobó con automatización de UI que
                    las 6 filas SÍ se llenan correctamente en el ViewModel, pero solo
                    ~3 se renderizaban visibles, las demás quedaban recortadas sin
                    scrollbar ni ningún indicio, dejando sus botones "Buscar"/"Quitar"
                    inalcanzables para un usuario real con mouse/teclado.
                -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Filas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Numero}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource BodyStyle}"/>
                                    <Border Grid.Column="1" CornerRadius="{StaticResource TextBoxCornerRadius}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}" Margin="0,0,6,0">
                                        <TextBox Text="{Binding Denominacion, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="{StaticResource TextBoxCornerRadius}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}" Margin="0,0,6,0">
                                        <TextBox Text="{Binding Codigo, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                                    </Border>
                                    <Border Grid.Column="3" CornerRadius="{StaticResource TextBoxCornerRadius}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}" Margin="0,0,6,0">
                                        <TextBox Text="{Binding Estado, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
                                    </Border>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Buscar"
                                                Command="{Binding DataContext.BuscarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}" Padding="8,4" Margin="0,0,4,0"/>
                                        <Button Content="Quitar"
                                                Command="{Binding DataContext.QuitarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}" Padding="8,4"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </GroupBox>

        <!-- ===================== Observaciones ===================== -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Observaciones:" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
            <Border CornerRadius="{StaticResource TextBoxCornerRadius}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}">
                <TextBox Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0" Background="Transparent"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="55" VerticalScrollBarVisibility="Auto"/>
            </Border>
            <TextBlock Text="{Binding MensajeError}"
                       Style="{StaticResource SmallStyle}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>
        </StackPanel>

        <!-- ===================== Acciones ===================== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Command="{Binding CancelarCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,10,0"/>
            <Button Content="Guardar" Command="{Binding GuardarCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="100" Margin="0,0,10,0"/>
            <Button Command="{Binding GuardarEImprimirCommand}" AutomationProperties.Name="Guardar e Imprimir" Style="{StaticResource SuccessButtonStyle}" Width="170">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="16" Height="16" Margin="0,0,8,0" Fill="White">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/print_add.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="Guardar e Imprimir" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
