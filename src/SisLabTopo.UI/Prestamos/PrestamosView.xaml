<UserControl x:Class="SisLabTopo.UI.Prestamos.PrestamosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SisLabTopo.UI.Controls"
             xmlns:converters="clr-namespace:SisLabTopo.UI.Converters"
             xmlns:prestamos="clr-namespace:SisLabTopo.UI.Prestamos"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=prestamos:PrestamosViewModel}"
             d:DesignWidth="1050" d:DesignHeight="600">
    <UserControl.Resources>
        <converters:FechaPrestamoToRowBrushConverter x:Key="FechaPrestamoToRowBrushConverter"/>

        <!--
            Puerto del renderer de filas de PrestamosPanel.java: blanco si <=7 días,
            RowOverdueWarningBrush si 7-14, RowOverdueDangerBrush si >14. Se asigna a
            InnerDataGrid.RowStyle en el code-behind (ver PrestamosView.xaml.cs) porque
            SearchableDataGrid no expone RowStyle como propiedad de dependencia propia.
        -->
        <Style x:Key="PrestamoRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
            <Setter Property="Background" Value="{Binding Prestamo.FechaPrestamo, Converter={StaticResource FechaPrestamoToRowBrushConverter}}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas -->
        <controls:RoundedCard Grid.Row="0" Margin="0,0,0,16" Padding="18,12">
            <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Monitoreo de Préstamos Activos" Style="{StaticResource SubtitleStyle}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Nuevo Préstamo" Command="{Binding NuevoPrestamoCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Ver Detalle" Command="{Binding VerDetalleCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Registrar Devolución" Command="{Binding RegistrarDevolucionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Imprimir" Command="{Binding ImprimirCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </controls:RoundedCard>

        <!-- Tabla -->
        <controls:SearchableDataGrid x:Name="TablaPrestamos"
                                      Grid.Row="1"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                      ItemsSource="{Binding Prestamos}"
                                      SelectedItem="{Binding PrestamoSeleccionado, Mode=TwoWay}">
            <controls:SearchableDataGrid.Columns>
                <DataGridTextColumn Header="ID Corto" Binding="{Binding IdCorto}" Width="90"/>
                <DataGridTextColumn Header="Estudiante" Binding="{Binding Prestamo.NombreEstudiante}" Width="*"/>
                <DataGridTextColumn Header="Docente" Binding="{Binding Prestamo.Docente}" Width="160"/>
                <DataGridTextColumn Header="Curso" Binding="{Binding Prestamo.Curso}" Width="160"/>
                <DataGridTextColumn Header="Semestre" Binding="{Binding Prestamo.Semestre}" Width="90"/>
                <DataGridTextColumn Header="Fecha Préstamo" Binding="{Binding Prestamo.FechaPrestamo, StringFormat='dd/MM/yyyy'}" Width="120"/>
                <DataGridTextColumn Header="Equipos (Cant.)" Binding="{Binding CantidadEquipos}" Width="120"/>
            </controls:SearchableDataGrid.Columns>
        </controls:SearchableDataGrid>
    </Grid>
</UserControl>
