<UserControl x:Class="SisLabTopo.UI.Prestamos.PrestamosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:SisLabTopo.UI.Controls"
             xmlns:converters="clr-namespace:SisLabTopo.UI.Converters"
             xmlns:prestamos="clr-namespace:SisLabTopo.UI.Prestamos"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=prestamos:PrestamosViewModel}"
             d:DesignWidth="1050" d:DesignHeight="600">
    <UserControl.Resources>
        <converters:FechaPrestamoToRowCategoriaConverter x:Key="FechaPrestamoToRowCategoriaConverter"/>

        <!--
            Puerto del renderer de filas de PrestamosPanel.java: fondo normal (heredado
            del Style base, ya reactivo al tema) si <=7 días, RowOverdueWarningBrush si
            7-14, RowOverdueDangerBrush si >14. Se asigna a InnerDataGrid.RowStyle en el
            code-behind (ver PrestamosView.xaml.cs) porque SearchableDataGrid no expone
            RowStyle como propiedad de dependencia propia.

            DataTrigger + DynamicResource (NO un converter que devuelva el Brush ya
            resuelto): ver el comentario de FechaPrestamoToRowCategoriaConverter para el
            bug real de modo oscuro que este cambio corrigió (filas "Normal" quedaban con
            fondo blanco fijo, ilegibles con texto claro).
        -->
        <Style x:Key="PrestamoRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource AppDataGridRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Prestamo.FechaPrestamo, Converter={StaticResource FechaPrestamoToRowCategoriaConverter}}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource RowOverdueWarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Prestamo.FechaPrestamo, Converter={StaticResource FechaPrestamoToRowCategoriaConverter}}" Value="Danger">
                    <Setter Property="Background" Value="{DynamicResource RowOverdueDangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas -->
        <controls:RoundedCard Grid.Row="0" Margin="0,0,0,16" Padding="18,12">
            <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Monitoreo de Préstamos Activos" Style="{StaticResource SubtitleStyle}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding NuevoPrestamoCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- "+" (Segoe MDL2 Assets, codepoint E710 "Add"), mismo criterio que el botón "Nuevo Equipo" de EquiposView. -->
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Nuevo Préstamo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding VerDetalleCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="16" Height="16" Margin="0,0,8,0" Fill="White">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/drag_click.png" Stretch="Uniform"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Ver Detalle" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RegistrarDevolucionCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="16" Height="16" Margin="0,0,8,0" Fill="White">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/SisLabTopo.UI;component/Assets/Icons/undo.png" Stretch="Uniform"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Registrar Devolución" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ImprimirCommand}" Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Impresora (Segoe MDL2 Assets, codepoint E749 "Print"). -->
                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Imprimir" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </controls:RoundedCard>

        <!-- Tabla -->
        <controls:SearchableDataGrid x:Name="TablaPrestamos"
                                      Grid.Row="1"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                      ItemsSource="{Binding Prestamos}"
                                      SelectedItem="{Binding PrestamoSeleccionado, Mode=TwoWay}">
            <controls:SearchableDataGrid.Columns>
                <DataGridTextColumn Header="ID Corto" Binding="{Binding IdCorto}" Width="90"/>
                <DataGridTextColumn Header="Estudiante" Binding="{Binding Prestamo.NombreEstudiante}" Width="*"/>
                <DataGridTextColumn Header="Docente" Binding="{Binding Prestamo.Docente}" Width="160"/>
                <DataGridTextColumn Header="Curso" Binding="{Binding Prestamo.Curso}" Width="160"/>
                <DataGridTextColumn Header="Semestre" Binding="{Binding Prestamo.Semestre}" Width="90"/>
                <DataGridTextColumn Header="Fecha Préstamo" Binding="{Binding Prestamo.FechaPrestamo, StringFormat='dd/MM/yyyy'}" Width="120"/>
                <DataGridTextColumn Header="Equipos (Cant.)" Binding="{Binding CantidadEquipos}" Width="120"/>
            </controls:SearchableDataGrid.Columns>
        </controls:SearchableDataGrid>
    </Grid>
</UserControl>
