<Window x:Class="SisLabTopo.UI.Shell.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:SisLabTopo.UI.Converters"
        mc:Ignorable="d"
        Title="SisLab-Topo — Laboratorio de Topografía Minera"
        Width="1150" Height="720"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <converters:ViewModelIsTypeConverter x:Key="ViewModelIsTypeConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SidebarWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== SIDEBAR (West, alto completo) ===================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <DockPanel Margin="12,20,12,16">

                <!-- Logos institucionales -->
                <Border DockPanel.Dock="Top"
                        Background="#061427"
                        CornerRadius="{StaticResource CardCornerRadius}"
                        BorderBrush="#20FFFFFF"
                        BorderThickness="1"
                        Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Image Source="/Assets/Logo_UNAP.png" Width="42" Height="42"/>
                            <TextBlock Text="UNIVERSIDAD NACIONAL DEL ALTIPLANO"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="8" Foreground="White"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="2,4,2,0"/>
                            <TextBlock Text="PUNO"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="8" Foreground="#7090b0"
                                       TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Image Source="/Assets/Logo_Minas.png" Width="42" Height="42"/>
                            <TextBlock Text="INGENIERÍA DE MINAS UNA - PUNO"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="8" Foreground="White"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="2,4,2,0"/>
                            <TextBlock Text="FIM"
                                       FontFamily="{StaticResource AppFontFamily}"
                                       FontSize="8" Foreground="#7090b0"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pie de página del sidebar -->
                <StackPanel DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                        <TextBlock Text="Sistema Administrativo"
                                   FontFamily="{StaticResource AppFontFamily}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="#A0B0C0"/>
                    </StackPanel>
                    <TextBlock Text="Versión 1.0 | UNA Puno"
                               FontFamily="{StaticResource AppFontFamily}"
                               FontSize="10"
                               Foreground="#708095"
                               Margin="4,4,0,0"/>
                </StackPanel>

                <!-- Navegación -->
                <StackPanel Margin="0,25,0,0">
                    <Button Content="Dashboard" Command="{Binding NavegarDashboardCommand}" Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="{Binding CurrentViewModel, Converter={StaticResource ViewModelIsTypeConverter}, ConverterParameter=DashboardViewModel}"/>
                    <Button Content="Equipos" Command="{Binding NavegarEquiposCommand}" Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="{Binding CurrentViewModel, Converter={StaticResource ViewModelIsTypeConverter}, ConverterParameter=EquiposViewModel}"/>
                    <Button Content="Préstamos Activos" Command="{Binding NavegarPrestamosCommand}" Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="{Binding CurrentViewModel, Converter={StaticResource ViewModelIsTypeConverter}, ConverterParameter=PrestamosViewModel}"/>
                    <Button Content="Historial" Command="{Binding NavegarHistorialCommand}" Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="{Binding CurrentViewModel, Converter={StaticResource ViewModelIsTypeConverter}, ConverterParameter=HistorialViewModel}"/>
                    <Button Content="Configuración" Command="{Binding NavegarConfiguracionCommand}" Style="{StaticResource SidebarNavButtonStyle}"
                            Tag="{Binding CurrentViewModel, Converter={StaticResource ViewModelIsTypeConverter}, ConverterParameter=ConfiguracionViewModel}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== DERECHA: TopBar + Contenido + StatusBar ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource TopBarHeight}"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="{StaticResource StatusBarHeight}"/>
            </Grid.RowDefinitions>

            <!-- TopBar -->
            <Border Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}" Padding="20,0">
                <Grid>
                    <TextBlock Text="SisLab-Topo — Laboratorio de Topografía Minera"
                               Style="{StaticResource SubtitleStyle}"
                               FontSize="15"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Docente: Administrador"
                                   Style="{StaticResource BodyStyle}"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"/>
                        <Button Content="Cerrar sesión"
                                Command="{Binding CerrarSesionCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Width="135" Height="34"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Contenido dinámico -->
            <ContentControl Grid.Row="1"
                             Content="{Binding CurrentViewModel}"
                             Margin="{StaticResource CardPadding}"/>

            <!-- StatusBar -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding EstadoEquiposTexto}"
                               Style="{StaticResource SmallStyle}"
                               FontWeight="Bold"
                               Foreground="#1B5E20"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
