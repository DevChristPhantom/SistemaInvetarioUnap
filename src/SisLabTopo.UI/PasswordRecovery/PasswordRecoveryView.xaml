<Window x:Class="SisLabTopo.UI.PasswordRecovery.PasswordRecoveryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:recovery="clr-namespace:SisLabTopo.UI.PasswordRecovery"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=recovery:PasswordRecoveryViewModel}"
        Title="Recuperar Contraseña de Administrador"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <!--
        Reemplaza el JOptionPane de la versión Java ("edite la celda de Excel a mano o
        borre la base de datos completa"): restablece la contraseña de administrador a
        partir del código de recuperación, sin destruir ningún otro dato.
    -->
    <StackPanel Margin="24" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">

        <!-- ===== Paso 1: código + nueva contraseña ===== -->
        <StackPanel Visibility="{Binding MostrandoCodigoNuevo, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TextBlock Text="Recuperar Contraseña" Style="{StaticResource TitleStyle}" FontSize="18"/>
            <TextBlock Text="Ingrese su código de recuperación y defina una nueva contraseña."
                       Style="{StaticResource SmallStyle}" TextWrapping="Wrap" Margin="0,4,0,20"/>

            <TextBlock Text="Código de Recuperación" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding CodigoRecuperacion, UpdateSourceTrigger=PropertyChanged}"
                     Tag="XXXX-XXXX-XXXX-XXXX" FontFamily="{StaticResource AppMonoFontFamily}" Margin="0,0,0,14"/>

            <TextBlock Text="Nueva Contraseña (mín. 6 caracteres)" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordNueva" Margin="0,0,0,2" PasswordChanged="PasswordNueva_PasswordChanged"/>
            <TextBlock Text="{Binding MensajeErrorNueva}" Style="{StaticResource SmallStyle}" FontWeight="Bold"
                       Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Visibility="{Binding MensajeErrorNueva, Converter={StaticResource StringToVisibilityConverter}}"/>

            <TextBlock Text="Confirmar Nueva Contraseña" Style="{StaticResource BodyStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordConfirmar" Margin="0,0,0,2" PasswordChanged="PasswordConfirmar_PasswordChanged"/>
            <TextBlock Text="{Binding MensajeErrorConfirmar}" Style="{StaticResource SmallStyle}" FontWeight="Bold"
                       Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Visibility="{Binding MensajeErrorConfirmar, Converter={StaticResource StringToVisibilityConverter}}"/>

            <TextBlock Text="{Binding MensajeError}" Style="{StaticResource BodyStyle}" FontWeight="Bold"
                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibilityConverter}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancelar" Command="{Binding CerrarCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="100" Margin="0,0,10,0"/>
                <Button Content="Restablecer Contraseña" Command="{Binding RestablecerCommand}" Style="{StaticResource SuccessButtonStyle}" Width="190"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== Paso 2: nuevo código de recuperación (una sola vez) ===== -->
        <StackPanel Visibility="{Binding MostrandoCodigoNuevo, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Contraseña Restablecida" Style="{StaticResource TitleStyle}" FontSize="18" Foreground="{StaticResource SuccessBrush}"/>
            <TextBlock Text="Se generó un nuevo código de recuperación. El código anterior ya no es válido. Guarde este código en un lugar seguro; no podrá volver a verlo."
                       Style="{StaticResource SmallStyle}" TextWrapping="Wrap" Margin="0,4,0,16"/>

            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1.5" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                <TextBlock Text="{Binding CodigoNuevo}" Style="{StaticResource MonoStyle}" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
            </Border>

            <Button Content="Copiar al Portapapeles" Command="{Binding CopiarCodigoCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Height="36" Margin="0,0,0,16"/>

            <CheckBox Content="Ya guardé el nuevo código de recuperación en un lugar seguro."
                      IsChecked="{Binding ConfirmoQueGuardeElCodigo}"
                      FontFamily="{StaticResource AppFontFamily}" FontSize="12"
                      Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,16"/>

            <Button Content="Cerrar" Command="{Binding CerrarCommand}" Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right" Width="120"/>
        </StackPanel>
    </StackPanel>
</Window>
