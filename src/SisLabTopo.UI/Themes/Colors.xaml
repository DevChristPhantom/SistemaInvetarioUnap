<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Paleta institucional UNA Puno. Puerto 1:1 de config/AppColors.java (Fase 4), con
        adiciones explícitas (con nombre, no hardcodeadas ad hoc como hacía Swing en cada
        pantalla) para el sidebar, las filas de préstamo vencido, y los colores por
        EstadoEquipo — así toda la app en Fase 5 consume exactamente los mismos recursos.
    -->

    <!-- Paleta base (idéntica a AppColors.java) -->
    <Color x:Key="PrimaryColor">#1a3a5c</Color>
    <Color x:Key="SecondaryColor">#2e6da4</Color>
    <Color x:Key="AccentColor">#f0a500</Color>
    <Color x:Key="SuccessColor">#28a745</Color>
    <Color x:Key="WarningColor">#ffc107</Color>
    <Color x:Key="DangerColor">#dc3545</Color>
    <Color x:Key="BackgroundColor">#f5f6fa</Color>
    <Color x:Key="CardColor">#ffffff</Color>
    <Color x:Key="TextDarkColor">#2c3e50</Color>
    <Color x:Key="TextLightColor">#7f8c8d</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDarkColor}"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLightColor}"/>

    <!--
        Sidebar / barra superior: en Java estos colores vivían hardcodeados directo en
        MainFrame.crearSidebar()/crearTopBar() (0x0A1D37, 0x071930, 0x0E4C92) sin pasar
        por AppColors. Aquí quedan centralizados con nombre. Se usa un único
        SidebarBackgroundBrush (0x0A1D37) para sidebar y topbar (Java usaba dos tonos muy
        cercanos -0x0A1D37 y 0x071930- sin razón funcional aparente).
    -->
    <Color x:Key="SidebarBackgroundColor">#0A1D37</Color>
    <Color x:Key="SidebarActiveColor">#0E4C92</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarActiveBrush" Color="{StaticResource SidebarActiveColor}"/>

    <!-- Resaltado de filas de préstamo vencido en tablas (Historial/Préstamos, Fase 5) -->
    <Color x:Key="RowOverdueWarningColor">#fff2cc</Color>
    <!-- 7-14 días -->
    <Color x:Key="RowOverdueDangerColor">#ffcccc</Color>
    <!-- >14 días -->
    <SolidColorBrush x:Key="RowOverdueWarningBrush" Color="{StaticResource RowOverdueWarningColor}"/>
    <SolidColorBrush x:Key="RowOverdueDangerBrush" Color="{StaticResource RowOverdueDangerColor}"/>

    <!--
        Colores por EstadoEquipo, con nombre como recurso (idénticos a
        EstadoEquipoExtensions.ColorHex() en SisLabTopo.Domain). Se declaran aquí también
        como recursos WPF para que XAML pueda referenciarlos directamente sin pasar por
        un converter cuando el estado ya se conoce en diseño; StatusBadge / los
        converters de Fase 5 los usan para el caso dinámico.
    -->
    <SolidColorBrush x:Key="EstadoBuenoBrush" Color="#28a745"/>
    <SolidColorBrush x:Key="EstadoRegularBrush" Color="#ffc107"/>
    <SolidColorBrush x:Key="EstadoMaloBrush" Color="#dc3545"/>
    <SolidColorBrush x:Key="EstadoNuevoBrush" Color="#17a2b8"/>
    <SolidColorBrush x:Key="EstadoDesusoBrush" Color="#6c757d"/>
    <SolidColorBrush x:Key="EstadoChatarraBrush" Color="#721c24"/>

    <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#e0e0e0"/>

</ResourceDictionary>
